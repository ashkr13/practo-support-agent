# Copy to .env (cp .env.example .env). No real secrets are required - the project
# runs entirely under MOCK_LLM with zero API keys.

# Deterministic offline mock for every LLM call (generation, judge, crew, review). Graded mode.
MOCK_LLM=true

# REQUIRED: disable CrewAI's outbound telemetry so kickoff() makes no network calls.
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Load the embedding model from the local cache only (after the one-time setup download).
HF_HUB_OFFLINE=1

# Runtime governance: per-request token budget (approx. tokens = chars / 4).
MAX_TOKENS_PER_REQUEST=10000

# Where ChromaDB persists its two collections, and where JSONL request logs go.
CHROMA_PATH=./chroma_db
LOG_PATH=./logs/requests.jsonl

# Optional: if set, POST /add-document requires header "X-Admin-Key: <value>".
# Leave empty for local development (the endpoint is then open and a warning is logged).
ADMIN_API_KEY=
